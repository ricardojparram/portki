#!/usr/bin/env sh
set -eu

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'portki requires Node.js at runtime.'
  printf '%s\n' 'Install Node.js 20 or newer, then run portki again.'
  exit 127
fi

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$SCRIPT_DIR/$LINK ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)

if [ "$#" -eq 0 ]; then
  if ! command -v bun >/dev/null 2>&1; then
    printf '%s\n' 'portki TUI currently requires Bun because OpenTUI uses Bun FFI.'
    printf '%s\n' 'Install Bun from https://bun.sh, then run portki again.'
    printf '%s\n' 'Non-TUI commands still work with Node: portki list --json'
    exit 127
  fi
  exec bun "$SCRIPT_DIR/../dist/index.js"
fi

exec node "$SCRIPT_DIR/../dist/index.js" "$@"
