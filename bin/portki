#!/usr/bin/env sh
set -eu

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'portki requires Node.js at runtime.'
  printf '%s\n' 'Install Node.js 20 or newer, then run portki again.'
  exit 127
fi

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
  LINK=$(readlink "$SCRIPT")
  case "$LINK" in
    /*) SCRIPT=$LINK ;;
    *) SCRIPT=$SCRIPT_DIR/$LINK ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd -P)
exec node "$SCRIPT_DIR/../dist/index.js" "$@"
